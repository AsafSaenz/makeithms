# Copia este archivo a .env y ajusta los valores.
DEBUG=True
SECRET_KEY=cambia-esto-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL local (en Render se inyecta DATABASE_URL automáticamente)
DATABASE_URL=postgres://makeithms:makeithms@localhost:5432/makeithms

# Archivos en Cloudflare R2 (déjalo vacío en local para usar media/)
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=

# Correo con Resend (SMTP). Vacío en local = correos a la consola.
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Make It HMS <no-reply@makeithms.com>
